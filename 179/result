class Solution(object):
    def largestNumber(self, nums):
        for i in range(len(nums)):
            for j in range(i+1,len(nums)):
                a = nums[i]
                b = nums[j]
                if str(a)+str(b)<str(b)+str(a):
                    nums[i],nums[j] = nums[j],nums[i]
        s = "".join(map(str,nums))            
        return s                 

        
